# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
MONGO_URI=

# --------------------------------------------
# REQUIRED: STARDUST
# --------------------------------------------
REDIS_URL=redis://default:<password>@<host>:<port>
STARDUST_SECRET=

# --------------------------------------------
# REQUIRED: SITE STATS
# --------------------------------------------
# At least 32 characters, e.g. `openssl rand -hex 32`. Salts the daily
# visitor hashes; changing it mid-day counts returning visitors again.
SITE_STATS_SECRET=

# --------------------------------------------
# REQUIRED: CORS
# --------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://astryss.acethekawaii.com

# --------------------------------------------
# OPTIONAL: PRODUCT IMAGE HOSTING (Cloudinary)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
